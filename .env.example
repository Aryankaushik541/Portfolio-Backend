PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://...
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
APP_NAME=Portfolio Admin

# Gmail SMTP for OTP email. Create a Gmail App Password after enabling
# 2-Step Verification; do not use your normal Gmail password.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Cloud deployment: use OpenAI. Keep this key on Render only.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=2048

# Local development only: leave AI_PROVIDER=auto and run Ollama locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=portfolio-developer
